# Mismas claves que .env, con valores de ejemplo en vez de los reales
# DB_NAME: nombre de la base (ejemplo)
DB_NAME=nombre-db
# DB_USER: usuario de MySQL (ejemplo)
DB_USER=nombre-usuario
# DB_PASSWORD: contraseña de relleno; la real solo va en .env
DB_PASSWORD=contraseña
# DB_HOST: servidor de ejemplo
DB_HOST=host
# DB_PORT: puerto de ejemplo
DB_PORT=puerto
# genera la tuya con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=clave-secreta
# True en local, False en Render
DEBUG=True
# en Render: tu-proyecto.onrender.com
ALLOWED_HOSTS=127.0.0.1,localhost
# en Render: https://tu-proyecto.onrender.com
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000